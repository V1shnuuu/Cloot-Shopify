{% doc %}
  Renders a premium modal/dialog component with smooth animations.
  Used for quick-view, size guides, loyalty programs, and confirmations.
  
  @param {string} [title] - Modal title
  @param {string} [id] - Unique modal identifier
  @param {boolean} [fullscreen_mobile] - Make fullscreen on mobile
  @param {string} [class] - Additional CSS classes
{% enddoc %}

{% stylesheet %}
  .modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    animation: fadeIn var(--transition-normal) ease-out;
  }

  .modal.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    animation: fadeIn var(--transition-normal) ease-out;
  }

  .modal-content {
    position: relative;
    z-index: 1;
    background: var(--color-white);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-2xl);
    max-width: 600px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    animation: slideInUp var(--transition-normal) ease-out;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-gray-200);
    position: sticky;
    top: 0;
    background: var(--color-white);
    z-index: 1;
  }

  .modal-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-gray-900);
  }

  .modal-close {
    width: 40px;
    height: 40px;
    border: none;
    background: var(--color-gray-100);
    border-radius: var(--radius-full);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-fast) ease-out;
    color: var(--color-gray-700);
  }

  .modal-close:hover {
    background: var(--color-gray-200);
    transform: rotate(90deg);
  }

  .modal-body {
    padding: var(--space-6);
  }

  .modal-footer {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    border-top: 1px solid var(--color-gray-200);
    background: var(--color-gray-50);
  }

  .modal-footer .btn {
    flex: 1;
  }

  @media (max-width: 768px) {
    .modal.fullscreen-mobile .modal-content {
      width: 100%;
      height: 100%;
      max-height: 100%;
      border-radius: 0;
    }

    .modal.fullscreen-mobile .modal-header {
      border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
    }
  }
{% endstylesheet %}

<div id="{{ id }}" class="modal {{ class }}">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-content">
    <div class="modal-header">
      <h2 class="modal-title">{{ title }}</h2>
      <button class="modal-close" data-close-modal" aria-label="Close modal">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <!-- Modal content will be inserted here -->
    </div>
  </div>
</div>

{% javascript %}
  document.querySelectorAll('[data-close-modal]').forEach(el => {
    el.addEventListener('click', function() {
      this.closest('.modal').classList.remove('active');
    });
  });
{% endjavascript %}

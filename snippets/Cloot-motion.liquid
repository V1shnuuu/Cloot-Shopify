{% doc %}
  Global motion and interaction handlers for Cloot.
{% enddoc %}
{% javascript %}
(() => {
  const body = document.body;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nav = document.querySelector('[data-tlm-nav]');
  const loader = document.querySelector('[data-tlm-loader]');

  const releaseLoader = () => {
    window.setTimeout(() => {
      body.classList.remove('tlm-is-loading');
      if (loader) {
        loader.setAttribute('aria-hidden', 'true');
      }
    }, prefersReduced ? 0 : 420);
  };

  if (document.readyState === 'complete') {
    releaseLoader();
  } else {
    window.addEventListener('load', releaseLoader, { once: true });
  }

  document.addEventListener('click', (event) => {
    const link = event.target.closest('a[href]');
    if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return;
    }
    const href = link.getAttribute('href');
    const target = link.getAttribute('target');
    if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || target === '_blank') {
      return;
    }
    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin) {
      return;
    }
    event.preventDefault();
    body.classList.add('tlm-page-leaving');
    window.setTimeout(() => {
      window.location.href = url.href;
    }, prefersReduced ? 0 : 360);
  });

  const setScrollState = () => {
    const scrolled = window.scrollY > 8;
    body.classList.toggle('tlm-scrolled', scrolled);
    if (nav) {
      nav.classList.toggle('is-scrolled', scrolled);
    }
  };

  window.addEventListener('scroll', setScrollState, { passive: true });
  setScrollState();

  const revealItems = document.querySelectorAll('[data-reveal]');
  revealItems.forEach((item, index) => {
    if (!item.style.getPropertyValue('--reveal-delay')) {
      item.style.setProperty('--reveal-delay', `${Math.min(index % 8, 7) * 70}ms`);
    }
  });
  if (!prefersReduced && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }

  if (!prefersReduced) {
    const magneticItems = document.querySelectorAll('[data-magnetic]');
    magneticItems.forEach((item) => {
      let rect = null;
      item.addEventListener('pointerenter', () => {
        rect = item.getBoundingClientRect();
      });
      item.addEventListener('pointermove', (event) => {
        if (!rect) {
          return;
        }
        const x = event.clientX - rect.left - rect.width / 2;
        const y = event.clientY - rect.top - rect.height / 2;
        item.style.transform = `translate(${x * 0.08}px, ${y * 0.08}px)`;
      });
      item.addEventListener('pointerleave', () => {
        item.style.transform = 'translate(0, 0)';
      });
    });
  }

  const mega = document.querySelector('[data-mega]');
  if (mega) {
    const triggers = document.querySelectorAll('[data-mega-trigger]');
    const panels = mega.querySelectorAll('[data-mega-panel]');
    const backdrop = mega.querySelector('[data-mega-backdrop]');
    const minWidth = window.matchMedia('(min-width: 990px)');
    let openKey = null;

    const getPanel = (key) => Array.from(panels).find((panel) => panel.dataset.megaPanel === key);

    const setActivePanel = (key) => {
      panels.forEach((panel) => {
        panel.classList.toggle('is-active', panel.dataset.megaPanel === key);
      });
    };

    const openMega = (key) => {
      if (!minWidth.matches) {
        return;
        }
      if (!getPanel(key)) {
        closeMega();
        return;
      }
      openKey = key;
      mega.classList.add('is-open');
      mega.setAttribute('aria-hidden', 'false');
      setActivePanel(key);
    };

    const closeMega = () => {
      openKey = null;
      mega.classList.remove('is-open');
      mega.setAttribute('aria-hidden', 'true');
      setActivePanel(null);
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('mouseenter', () => {
        openMega(trigger.dataset.megaTarget);
      });
      trigger.addEventListener('focusin', () => {
        openMega(trigger.dataset.megaTarget);
      });
    });

    mega.addEventListener('mouseleave', closeMega);
    if (backdrop) {
      backdrop.addEventListener('click', closeMega);
    }

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMega();
      }
    });
  }

  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const mobileOpen = document.querySelector('[data-mobile-open]');
  const mobileClose = document.querySelector('[data-mobile-close]');

  const toggleMobileMenu = (open) => {
    if (!mobileMenu) {
      return;
    }
    if (open) {
      toggleSearch(false);
      toggleCart(false);
    }
    mobileMenu.classList.toggle('is-open', open);
    mobileMenu.setAttribute('aria-hidden', open ? 'false' : 'true');
    body.classList.toggle('tlm-lock', open);
    if (mobileOpen) {
      mobileOpen.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
  };

  if (mobileOpen) {
    mobileOpen.addEventListener('click', () => toggleMobileMenu(true));
  }
  if (mobileClose) {
    mobileClose.addEventListener('click', () => toggleMobileMenu(false));
  }

  const searchOverlay = document.querySelector('[data-search-overlay]');
  const searchOpen = document.querySelectorAll('[data-search-open]');
  const searchCloseButtons = searchOverlay ? searchOverlay.querySelectorAll('[data-search-close]') : [];

  const toggleSearch = (open) => {
    if (!searchOverlay) {
      return;
    }
    if (open) {
      toggleCart(false);
      toggleMobileMenu(false);
    }
    searchOverlay.classList.toggle('is-open', open);
    searchOverlay.setAttribute('aria-hidden', open ? 'false' : 'true');
    body.classList.toggle('tlm-lock', open);
    const input = searchOverlay.querySelector('[data-search-input]');
    if (open && input) {
      input.focus();
    }
  };

  searchOpen.forEach((button) => {
    button.addEventListener('click', () => toggleSearch(true));
  });

  searchCloseButtons.forEach((button) => {
    button.addEventListener('click', () => toggleSearch(false));
  });

  const cartDrawer = document.querySelector('[data-cart-drawer]');
  const cartOpen = document.querySelectorAll('[data-cart-open]');
  const cartCloseButtons = cartDrawer ? cartDrawer.querySelectorAll('[data-cart-close]') : [];

  const toggleCart = (open) => {
    if (!cartDrawer) {
      return;
    }
    if (open) {
      toggleSearch(false);
      toggleMobileMenu(false);
    }
    cartDrawer.classList.toggle('is-open', open);
    cartDrawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    body.classList.toggle('tlm-lock', open);
  };

  cartOpen.forEach((button) => {
    button.addEventListener('click', () => toggleCart(true));
  });

  cartCloseButtons.forEach((button) => {
    button.addEventListener('click', () => toggleCart(false));
  });

  const updateCartCount = async () => {
    try {
      const response = await fetch('/cart.js');
      if (!response.ok) {
        return;
      }
      const data = await response.json();
      document.querySelectorAll('[data-cart-count]').forEach((node) => {
        node.textContent = data.item_count;
        node.classList.toggle('is-hidden', data.item_count === 0);
      });
    } catch (error) {
      return;
    }
  };

  document.addEventListener('submit', async (event) => {
    const form = event.target;
    if (!form || !form.matches('[data-quick-add]')) {
      return;
    }
    event.preventDefault();
    const formData = new FormData(form);
    const id = formData.get('id');
    if (!id) {
      return;
    }
    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, quantity: 1 })
      });
      if (!response.ok) {
        return;
      }
      await updateCartCount();
      toggleCart(true);
    } catch (error) {
      return;
    }
  });

  if (searchOverlay) {
    const predictiveUrl = searchOverlay.dataset.predictiveSearchUrl;
    const input = searchOverlay.querySelector('[data-search-input]');
    const results = searchOverlay.querySelector('[data-search-results]');
    if (input && results && predictiveUrl) {
      let timeoutId = null;
      input.addEventListener('input', () => {
        const query = input.value.trim();
        if (timeoutId) {
          window.clearTimeout(timeoutId);
        }
        timeoutId = window.setTimeout(async () => {
          if (query.length < 2) {
            results.innerHTML = '';
            return;
          }
          try {
            const url = `${predictiveUrl}?q=${encodeURIComponent(query)}&resources[type]=product,collection,article,page&resources[limit]=6&resources[options][unavailable_products]=hide`;
            const response = await fetch(url, { headers: { Accept: 'application/json' } });
            if (!response.ok) {
              return;
            }
            const data = await response.json();
            const resources = data.resources || {};
            const resourceResults = resources.results || {};
            const items = [
              ...(resourceResults.products || []),
              ...(resourceResults.collections || [])
            ];
            if (items.length === 0) {
              results.innerHTML = '<p class="tlm-search__empty">No matches found.</p>';
              return;
            }
            results.innerHTML = items
              .slice(0, 6)
              .map((item) => {
                const title = item.title || 'Result';
                const url = item.url || '#';
                return `<a class="tlm-search__result" href="${url}"><span>${title}</span><span class="tlm-search__arrow">View</span></a>`;
              })
              .join('');
          } catch (error) {
            return;
          }
        }, 220);
      });
    }
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      toggleSearch(false);
      toggleCart(false);
      toggleMobileMenu(false);
    }
  });

  const cursor = document.querySelector('[data-tlm-cursor]');
  const cursorRing = document.querySelector('[data-tlm-cursor-ring]');
  const supportsFinePointer = window.matchMedia('(pointer: fine)').matches;

  if (!prefersReduced && cursor && cursorRing && supportsFinePointer) {
    body.classList.add('tlm-cursor-active');
    let x = 0;
    let y = 0;
    let ringX = 0;
    let ringY = 0;

    const animate = () => {
      ringX += (x - ringX) * 0.2;
      ringY += (y - ringY) * 0.2;
      cursor.style.left = `${x}px`;
      cursor.style.top = `${y}px`;
      cursorRing.style.left = `${ringX}px`;
      cursorRing.style.top = `${ringY}px`;
      requestAnimationFrame(animate);
    };

    document.addEventListener('pointermove', (event) => {
      x = event.clientX;
      y = event.clientY;
    });

    document.addEventListener('pointerover', (event) => {
      cursorRing.classList.toggle('is-hovering', Boolean(event.target.closest('a, button, input, select, textarea, [data-cursor-text]')));
    });

    animate();
  }

  const parallaxItems = document.querySelectorAll('[data-parallax]');
  if (!prefersReduced && parallaxItems.length) {
    let ticking = false;
    const updateParallax = () => {
      parallaxItems.forEach((item) => {
        const speed = Number(item.dataset.parallaxSpeed || 0.15);
        item.style.transform = `translateY(${window.scrollY * speed}px)`;
      });
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true });
    updateParallax();
  }

  const heroSections = document.querySelectorAll('[data-hero]');
  if (!prefersReduced) {
    heroSections.forEach((hero) => {
      hero.addEventListener('pointermove', (event) => {
        const rect = hero.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width) * 100;
        const y = ((event.clientY - rect.top) / rect.height) * 100;
        hero.style.setProperty('--hero-x', `${x}%`);
        hero.style.setProperty('--hero-y', `${y}%`);
      });
      hero.addEventListener('pointerleave', () => {
        hero.style.setProperty('--hero-x', '50%');
        hero.style.setProperty('--hero-y', '30%');
      });
    });
  }

  if (!prefersReduced) {
    const tiltCards = document.querySelectorAll('[data-tilt]');
    tiltCards.forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `perspective(900px) rotateX(${y * -4}deg) rotateY(${x * 5}deg) translateY(-4px)`;
      });
      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
      });
    });
  }

  const quickView = document.querySelector('[data-quick-view]');
  if (quickView) {
    const quickImage = quickView.querySelector('[data-quick-view-image]');
    const quickTitle = quickView.querySelector('[data-quick-view-title]');
    const quickPrice = quickView.querySelector('[data-quick-view-price]');
    const quickLink = quickView.querySelector('[data-quick-view-link]');
    const closeQuickView = () => {
      quickView.classList.remove('is-open');
      quickView.setAttribute('aria-hidden', 'true');
      body.classList.remove('tlm-lock');
    };

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-quick-view-trigger]');
      if (!trigger) {
        return;
      }
      event.preventDefault();
      if (quickImage) {
        quickImage.src = trigger.dataset.productImage || '';
        quickImage.alt = trigger.dataset.productTitle || '';
      }
      if (quickTitle) {
        quickTitle.textContent = trigger.dataset.productTitle || '';
      }
      if (quickPrice) {
        quickPrice.textContent = trigger.dataset.productPrice || '';
      }
      if (quickLink) {
        quickLink.href = trigger.dataset.productUrl || '#';
      }
      quickView.classList.add('is-open');
      quickView.setAttribute('aria-hidden', 'false');
      body.classList.add('tlm-lock');
    });

    quickView.querySelectorAll('[data-quick-view-close]').forEach((button) => {
      button.addEventListener('click', closeQuickView);
    });
  }

  const lightbox = document.querySelector('[data-lightbox]');
  if (lightbox) {
    const lightboxImage = lightbox.querySelector('[data-lightbox-image]');
    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      body.classList.remove('tlm-lock');
    };

    document.addEventListener('click', (event) => {
      const trigger = event.target.closest('[data-zoom-image]');
      if (!trigger) {
        return;
      }
      event.preventDefault();
      if (lightboxImage) {
        lightboxImage.src = trigger.dataset.zoomImage || trigger.href || '';
        lightboxImage.alt = trigger.dataset.zoomAlt || '';
      }
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      body.classList.add('tlm-lock');
    });

    lightbox.querySelectorAll('[data-lightbox-close]').forEach((button) => {
      button.addEventListener('click', closeLightbox);
    });
  }

  document.querySelectorAll('[data-product-form]').forEach((form) => {
    const priceNodes = document.querySelectorAll(`[data-product-price="${form.dataset.productForm}"]`);
    const hiddenInput = form.querySelector('input[name="id"]');
    const radios = form.querySelectorAll('[data-variant-radio]');
    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        if (!radio.checked) {
          return;
        }
        if (hiddenInput) {
          hiddenInput.value = radio.value;
        }
        priceNodes.forEach((priceNode) => {
          if (radio.dataset.variantPrice) {
            priceNode.textContent = radio.dataset.variantPrice;
          }
        });
        form.querySelectorAll('[data-variant-swatch]').forEach((swatch) => {
          swatch.classList.toggle('is-active', swatch.dataset.variantSwatch === radio.value);
        });
      });
    });
  });

  const currentProduct = document.querySelector('[data-current-product]');
  const recentMount = document.querySelector('[data-recently-viewed]');
  if (currentProduct && window.localStorage) {
    try {
      const item = JSON.parse(currentProduct.textContent);
      const key = 'tlm_recently_viewed';
      const existing = JSON.parse(window.localStorage.getItem(key) || '[]').filter((entry) => entry.url !== item.url);
      window.localStorage.setItem(key, JSON.stringify([item, ...existing].slice(0, 6)));
    } catch (error) {
      return;
    }
  }
  if (recentMount && window.localStorage) {
    try {
      const items = JSON.parse(window.localStorage.getItem('tlm_recently_viewed') || '[]')
        .filter((item) => item.url !== recentMount.dataset.currentUrl)
        .slice(0, 4);
      if (!items.length) {
        recentMount.closest('[data-recently-viewed-section]')?.remove();
      } else {
        recentMount.innerHTML = items
          .map((item) => `<a class="tlm-recent-card" href="${item.url}"><span class="tlm-recent-card__media"><img src="${item.image}" alt="${item.title}" loading="lazy"></span><span>${item.title}</span><small>${item.price}</small></a>`)
          .join('');
      }
    } catch (error) {
      recentMount.closest('[data-recently-viewed-section]')?.remove();
    }
  }

  document.querySelectorAll('[data-swipe-close]').forEach((panel) => {
    let startX = 0;
    panel.addEventListener('touchstart', (event) => {
      startX = event.touches[0]?.clientX || 0;
    }, { passive: true });
    panel.addEventListener('touchend', (event) => {
      const endX = event.changedTouches[0]?.clientX || 0;
      if (Math.abs(endX - startX) > 90 && endX > startX) {
        const close = panel.querySelector('[data-mobile-close], [data-cart-close], [data-search-close]');
        if (close) {
          close.click();
        }
      }
    }, { passive: true });
  });
})();
{% endjavascript %}

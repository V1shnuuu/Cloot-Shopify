{% doc %}
  Renders a premium pricing card component with tiered features and CTA.
  Perfect for pricing tiers, membership levels, or product variants.
  
  @param {string} name - Tier name
  @param {string} price - Display price
  @param {string} description - Tier description
  @param {array} features - Array of feature strings
  @param {string} [cta_text] - Call-to-action button text
  @param {string} [cta_url] - Call-to-action URL
  @param {boolean} [featured] - Highlight as featured tier
  @param {string} [class] - Additional CSS classes
{% enddoc %}

{% stylesheet %}
  .pricing-card {
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    background: var(--color-white);
    border: 2px solid var(--color-gray-200);
    transition: all var(--transition-normal) ease-out;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
  }

  .pricing-card.featured {
    border-color: var(--color-primary-500);
    background: var(--gradient-glass);
    transform: scale(1.05);
    box-shadow: 0 0 30px rgba(14, 165, 233, 0.2);
  }

  .pricing-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-lg);
  }

  .pricing-badge {
    position: absolute;
    top: -12px;
    left: var(--space-6);
    background: var(--gradient-warm);
    color: var(--color-white);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
  }

  .pricing-header {
    margin-bottom: var(--space-6);
    text-align: center;
  }

  .pricing-name {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-gray-900);
    margin-bottom: var(--space-2);
  }

  .pricing-description {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
  }

  .pricing-price {
    text-align: center;
    margin: var(--space-6) 0;
  }

  .pricing-amount {
    font-size: var(--font-size-5xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-gray-900);
    line-height: 1;
  }

  .pricing-currency {
    font-size: var(--font-size-lg);
  }

  .pricing-period {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    margin-top: var(--space-2);
  }

  .pricing-features {
    list-style: none;
    margin: var(--space-6) 0;
    flex: 1;
  }

  .pricing-features li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-gray-100);
    font-size: var(--font-size-sm);
    color: var(--color-gray-700);
  }

  .pricing-features li:last-child {
    border-bottom: none;
  }

  .feature-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    background: var(--color-primary-100);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-600);
    font-weight: var(--font-weight-bold);
  }

  .pricing-cta {
    margin-top: var(--space-6);
  }

  .pricing-cta .btn {
    width: 100%;
  }
{% endstylesheet %}

<div class="pricing-card {% if featured %}featured{% endif %} {{ class }}">
  {% if featured %}<span class="pricing-badge">Popular</span>{% endif %}

  <div class="pricing-header">
    <h3 class="pricing-name">{{ name }}</h3>
    <p class="pricing-description">{{ description }}</p>
  </div>

  <div class="pricing-price">
    <div class="pricing-amount"><span class="pricing-currency">$</span>{{ price }}</div>
    <p class="pricing-period">per month</p>
  </div>

  <ul class="pricing-features">
    {% for feature in features %}
      <li>
        <span class="feature-icon">✓</span>
        {{ feature }}
      </li>
    {% endfor %}
  </ul>

  <div class="pricing-cta">
    {% render 'button', 
      text: cta_text | default: 'Get Started',
      url: cta_url,
      variant: featured | default: false | ? 'primary' : 'outline',
      full_width: true
    %}
  </div>
</div>

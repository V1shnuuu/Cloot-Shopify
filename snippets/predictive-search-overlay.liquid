{% doc %}
  Predictive search overlay for Cloot.
{% enddoc %}
<div class="tlm-search" data-search-overlay data-predictive-search-url="{{ routes.predictive_search_url }}" aria-hidden="true" role="dialog">
  <div class="tlm-search__backdrop" data-search-close></div>
  <div class="tlm-search__panel" data-swipe-close>
    <div class="tlm-search__header">
      <p class="tlm-eyebrow">Search</p>
      <button class="tlm-icon-btn" type="button" data-search-close aria-label="Close search">
        {% render 'icon-close' %}
      </button>
    </div>
    <form class="tlm-search__form" action="{{ routes.search_url }}" method="get" role="search">
      <input
        class="tlm-search__input"
        type="search"
        name="q"
        placeholder="Search Cloot"
        autocomplete="off"
        data-search-input
        aria-label="Search"
      >
      <button class="tlm-btn tlm-btn--ghost" type="submit">Explore</button>
    </form>
    <div class="tlm-search__suggestions" aria-label="Suggested searches">
      <a href="{{ routes.search_url }}?q=3D%20logos">3D Logos</a>
      <a href="{{ routes.search_url }}?q=clothing">Clothing</a>
      <a href="{{ routes.search_url }}?q=keychains">Keychains</a>
      <a href="{{ routes.search_url }}?q=custom">Custom</a>
    </div>
    <div class="tlm-search__results" data-search-results></div>
  </div>
</div>

{% doc %}
  Renders a premium card component with glassmorphism effect.
  Perfect for product cards, testimonials, feature boxes, or content containers.
  
  @param {string} [title] - Optional card title
  @param {string} [description] - Optional card description
  @param {image} [image] - Optional card image
  @param {string} [badge] - Optional badge text (e.g., "On Sale", "New")
  @param {string} [hover_effect] - Hover effect: 'lift' (default), 'glow', 'scale'
  @param {boolean} [use_glass] - Use glassmorphism effect
  @param {string} [class] - Additional CSS classes
{% enddoc %}

{% stylesheet %}
  .card {
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--color-white);
    transition: all var(--transition-normal) ease-out;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card.glass {
    background: var(--gradient-glass);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .card.glass::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--shadow-glass);
    border-radius: var(--radius-2xl);
  }

  .card.hover-lift:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .card.hover-glow:hover {
    box-shadow: 0 0 30px rgba(14, 165, 233, 0.2);
  }

  .card.hover-scale:hover {
    transform: scale(1.02);
  }

  .card-image-container {
    position: relative;
    width: 100%;
    height: 300px;
    overflow: hidden;
    background: var(--color-gray-100);
  }

  .card-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal) ease-out;
  }

  .card:hover .card-image-container img {
    transform: scale(1.05);
  }

  .card-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: var(--gradient-warm);
    color: var(--color-white);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: var(--shadow-lg);
  }

  .card-content {
    padding: var(--space-6);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-gray-900);
  }

  .card-description {
    font-size: var(--font-size-sm);
    color: var(--color-gray-600);
    line-height: var(--line-height-relaxed);
  }

  .card-footer {
    padding-top: var(--space-4);
    margin-top: auto;
    border-top: 1px solid var(--color-gray-200);
    display: flex;
    gap: var(--space-3);
  }
{% endstylesheet %}

<div class="card hover-{{ hover_effect | default: 'lift' }} {% if use_glass %}glass{% endif %} {{ class }}" style="box-shadow: var(--shadow-md);">
  {% if image %}
    <div class="card-image-container">
      {{ image | image_url: width: 500 | image_tag: class: 'w-full h-full object-cover' }}
      {% if badge %}
        <span class="card-badge">{{ badge }}</span>
      {% endif %}
    </div>
  {% endif %}
  
  <div class="card-content">
    {% if title %}
      <h3 class="card-title">{{ title }}</h3>
    {% endif %}
    {% if description %}
      <p class="card-description">{{ description }}</p>
    {% endif %}
  </div>

  {% if card_footer %}
    <div class="card-footer">
      {{ card_footer }}
    </div>
  {% endif %}
</div>

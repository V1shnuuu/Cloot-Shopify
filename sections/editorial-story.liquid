{% stylesheet %}
  .tlm-editorial {
    position: relative;
    padding: 100px 0;
    overflow: clip;
  }

  .tlm-editorial__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .tlm-editorial__media {
    position: sticky;
    top: 110px;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: var(--tlm-shadow-soft);
  }

  .tlm-editorial__media img {
    transition: transform 900ms var(--tlm-ease-cinematic), filter 900ms var(--tlm-ease-cinematic);
  }

  .tlm-editorial__media:hover img {
    transform: scale(1.05);
    filter: saturate(0.86) contrast(1.08);
  }

  .tlm-editorial__placeholder {
    width: 100%;
    height: 100%;
    min-height: 360px;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0));
  }

  .tlm-editorial__content {
    display: grid;
    gap: 20px;
    align-content: center;
  }

  .tlm-editorial__text {
    color: var(--tlm-muted);
    line-height: 1.7;
  }

  .tlm-editorial.is-media-right .tlm-editorial__media {
    order: 2;
  }

  .tlm-editorial__notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .tlm-editorial__note {
    border: 1px solid rgba(242, 241, 237, 0.1);
    border-radius: 8px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.02);
  }

  .tlm-editorial__note strong {
    display: block;
    font-family: var(--tlm-font-display);
    font-size: 1.4rem;
    font-weight: 400;
  }

  .tlm-editorial__note span {
    color: var(--tlm-muted);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .tlm-editorial__grid {
      grid-template-columns: 1fr;
    }

    .tlm-editorial.is-media-right .tlm-editorial__media {
      order: 0;
    }

    .tlm-editorial__media {
      position: relative;
      top: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .tlm-editorial__notes {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

<section class="tlm-editorial {{ section.settings.layout }}">
  <div class="tlm-marquee" aria-hidden="true">
    <div class="tlm-marquee__track">
      <span class="tlm-marquee__item">{{ section.settings.marquee_text }}</span>
      <span class="tlm-marquee__item">{{ section.settings.marquee_text }}</span>
      <span class="tlm-marquee__item">{{ section.settings.marquee_text }}</span>
      <span class="tlm-marquee__item">{{ section.settings.marquee_text }}</span>
    </div>
  </div>
  <div class="tlm-editorial__grid tlm-container">
    <div class="tlm-editorial__media" data-reveal data-parallax data-parallax-speed="-0.03">
      {% if section.settings.image != blank %}
        {% render 'image', image: section.settings.image, width: 1200, height: 1400, crop: 'center' %}
      {% else %}
        <div class="tlm-editorial__placeholder"></div>
      {% endif %}
    </div>
    <div class="tlm-editorial__content" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="tlm-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="tlm-title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="tlm-editorial__text">{{ section.settings.text }}</p>
      {% endif %}
      <div class="tlm-editorial__notes">
        <div class="tlm-editorial__note">
          <strong>{{ section.settings.stat_one }}</strong>
          <span>{{ section.settings.stat_one_label }}</span>
        </div>
        <div class="tlm-editorial__note">
          <strong>{{ section.settings.stat_two }}</strong>
          <span>{{ section.settings.stat_two_label }}</span>
        </div>
        <div class="tlm-editorial__note">
          <strong>{{ section.settings.stat_three }}</strong>
          <span>{{ section.settings.stat_three_label }}</span>
        </div>
      </div>
      {% if section.settings.cta_label != blank %}
        {% if section.settings.cta_link != blank %}
          <a class="tlm-btn" href="{{ section.settings.cta_link }}" data-magnetic>{{ section.settings.cta_label }}</a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TLM Editorial Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Editorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Structured silhouettes, cinematic motion"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Cloot frames each drop like a fashion editorial. Layered tones, oversized volume, and precise tailoring create a story of movement and identity."
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "Cloot · CUSTOM LOGOS · CLOTHING · KEYCHAINS ·"
    },
    {
      "type": "text",
      "id": "stat_one",
      "label": "Stat one",
      "default": "3D"
    },
    {
      "type": "text",
      "id": "stat_one_label",
      "label": "Stat one label",
      "default": "Logo craft"
    },
    {
      "type": "text",
      "id": "stat_two",
      "label": "Stat two",
      "default": "Drop"
    },
    {
      "type": "text",
      "id": "stat_two_label",
      "label": "Stat two label",
      "default": "Streetwear rhythm"
    },
    {
      "type": "text",
      "id": "stat_three",
      "label": "Stat three",
      "default": "Custom"
    },
    {
      "type": "text",
      "id": "stat_three_label",
      "label": "Stat three label",
      "default": "Identity pieces"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore the story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "is-media-left", "label": "Image left" },
        { "value": "is-media-right", "label": "Image right" }
      ],
      "default": "is-media-left"
    }
  ],
  "presets": [
    {
      "name": "Cloot Editorial Story"
    }
  ]
}
{% endschema %}

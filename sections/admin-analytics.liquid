          <td><span class="status-badge completed">Delivered</span></td>
          <td>Dec 15, 2024</td>
          <td><a href="#" style="color: var(--color-primary-600); text-decoration: none;">View</a></td>
        </tr>
        <tr>
          <td>#1000</td>
          <td>Jane Smith</td>
          <td>$89.50</td>
          <td><span class="status-badge completed">Delivered</span></td>
          <td>Dec 14, 2024</td>
          <td><a href="#" style="color: var(--color-primary-600); text-decoration: none;">View</a></td>
        </tr>
        <tr>
          <td>#999</td>
          <td>Mike Johnson</td>
          <td>$199.99</td>
          <td><span class="status-badge pending">Processing</span></td>
          <td>Dec 13, 2024</td>
          <td><a href="#" style="color: var(--color-primary-600); text-decoration: none;">View</a></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

{% stylesheet %}
  .tlm-recommendations {
    padding: 80px 0;
  }

  .tlm-recommendations__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .tlm-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 4), minmax(0, 1fr));
    gap: 20px;
  }

  .tlm-recommendation-card {
    display: grid;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tlm-recommendation-card__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
  }

  .tlm-recommendation-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tlm-recommendation-card small {
    color: var(--tlm-muted);
  }

  @media screen and (max-width: 989px) {
    .tlm-recommendations__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .tlm-recommendations {
      padding: 56px 0;
    }

    .tlm-recommendations__header {
      display: grid;
    }

    .tlm-recommendations__grid {
      grid-auto-flow: column;
      grid-auto-columns: minmax(220px, 74vw);
      grid-template-columns: none;
      overflow-x: auto;
      padding-bottom: 10px;
      scroll-snap-type: x mandatory;
    }

    .tlm-recommendations__grid > * {
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% assign shelf_collection = section.settings.collection %}
<section
  class="tlm-recommendations"
  data-recommendation-shelf
  data-recommendation-strategy="{{ section.settings.strategy }}"
  data-limit="{{ section.settings.limit }}"
  {% if product %}data-current-product-id="{{ product.id }}" data-current-product-url="{{ product.url }}"{% endif %}
  {% if collection %}data-collection-id="{{ collection.id }}"{% endif %}
>
  <div class="tlm-container">
    <div class="tlm-recommendations__header" data-reveal>
      <div>
        <p class="tlm-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="tlm-title">{{ section.settings.heading }}</h2>
      </div>
      {% if shelf_collection != blank %}
        <a class="tlm-btn tlm-btn--ghost" href="{{ shelf_collection.url }}">View all</a>
      {% endif %}
    </div>

    {% if section.settings.strategy == 'recently_viewed' %}
      <div class="tlm-recommendations__grid" data-recommendation-results></div>
    {% elsif shelf_collection != blank %}
      <div class="tlm-recommendations__grid" style="--columns: {{ section.settings.columns }};">
        {% for recommendation in shelf_collection.products limit: section.settings.limit %}
          {% if product %}
            {% unless recommendation.id == product.id %}
              {% render 'product-card', product: recommendation, show_quick_add: true %}
            {% endunless %}
          {% else %}
            {% render 'product-card', product: recommendation, show_quick_add: true %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="tlm-recommendations__grid" data-recommendation-results></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Recommendation engine",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recommendation engine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built around your last moves"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Fallback collection"
    },
    {
      "type": "select",
      "id": "strategy",
      "label": "Strategy",
      "options": [
        { "value": "recently_viewed", "label": "Recently viewed" },
        { "value": "similar_products", "label": "Similar products" },
        { "value": "complete_the_look", "label": "Complete the look" },
        { "value": "trending", "label": "Trending" }
      ],
      "default": "similar_products"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Product limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Recommendation engine"
    }
  ]
}
{% endschema %}

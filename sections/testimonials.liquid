{% stylesheet %}
  .testimonials-premium {
    padding: clamp(56px, 8vw, 108px) 0;
  }

  .testimonials-premium__header {
    max-width: 720px;
    margin-bottom: 30px;
  }

  .testimonials-premium__title {
    font-family: var(--tlm-font-display);
    font-size: clamp(1.8rem, 4.4vw, 3.8rem);
    text-transform: uppercase;
    line-height: 1;
  }

  .testimonials-premium__description {
    margin-top: 12px;
    color: var(--tlm-muted);
    line-height: 1.7;
  }

  .testimonials-premium__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .testimonials-premium__card {
    border: 1px solid rgba(242, 241, 237, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    padding: 22px;
    display: grid;
    gap: 14px;
  }

  .testimonials-premium__stars {
    letter-spacing: 0.2em;
    color: var(--tlm-accent);
    font-size: 12px;
  }

  .testimonials-premium__quote {
    color: rgba(242, 241, 237, 0.84);
    line-height: 1.7;
    font-size: 0.98rem;
  }

  .testimonials-premium__author {
    border-top: 1px solid rgba(242, 241, 237, 0.09);
    padding-top: 12px;
    display: grid;
    gap: 4px;
  }

  .testimonials-premium__author strong {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.74rem;
  }

  .testimonials-premium__author span {
    color: var(--tlm-muted);
    font-size: 0.85rem;
  }

  @media screen and (max-width: 989px) {
    .testimonials-premium__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .testimonials-premium__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

<section class="testimonials-premium">
  <div class="tlm-container">
    <header class="testimonials-premium__header" data-reveal>
      {% if section.settings.title != blank %}
        <h2 class="testimonials-premium__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="testimonials-premium__description">{{ section.settings.description }}</p>
      {% endif %}
    </header>

    <div class="testimonials-premium__grid">
      {% for block in section.blocks %}
        <article class="testimonials-premium__card" data-reveal {{ block.shopify_attributes }}>
          <p class="testimonials-premium__stars">
            {% for i in (1..block.settings.rating) %}★{% endfor %}
          </p>
          <p class="testimonials-premium__quote">{{ block.settings.quote }}</p>
          <div class="testimonials-premium__author">
            <strong>{{ block.settings.name }}</strong>
            <span>{{ block.settings.role }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Trusted by modern icons" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "A premium storefront experience designed for conversion and storytelling." }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Exceptional quality, fast checkout, and visuals that finally match our brand." },
        { "type": "text", "id": "name", "label": "Name", "default": "Riya Menon" },
        { "type": "text", "id": "role", "label": "Role", "default": "Creative Director" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}

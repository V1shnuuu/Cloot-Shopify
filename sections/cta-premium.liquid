{% stylesheet %}
  .cta-premium {
    position: relative;
    padding: clamp(52px, 8vw, 90px);
    overflow: hidden;
    border-radius: 24px;
    margin: 0 var(--tlm-page-gutter) clamp(56px, 8vw, 96px);
    border: 1px solid rgba(242, 241, 237, 0.14);
    background: radial-gradient(circle at 70% 20%, rgba(214, 201, 170, 0.2), transparent 34%), #111;
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.46);
  }

  .cta-premium::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0));
  }

  .cta-premium__background {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .cta-premium__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .cta-premium__content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    color: var(--tlm-fg);
    text-align: center;
    margin-inline: auto;
  }

  .cta-premium__content.left {
    text-align: left;
    margin-inline: 0 auto;
  }

  .cta-premium__content.right {
    text-align: right;
    margin-inline: auto 0;
  }

  .cta-premium__title {
    font-family: var(--tlm-font-display);
    font-size: clamp(2rem, 4.6vw, 4rem);
    margin-bottom: 14px;
    line-height: 1;
    text-transform: uppercase;
  }

  .cta-premium__description {
    margin-bottom: 22px;
    color: var(--tlm-muted);
    line-height: 1.7;
  }

  .cta-premium__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-premium__content.left .cta-premium__buttons {
    justify-content: flex-start;
  }

  .cta-premium__content.right .cta-premium__buttons {
    justify-content: flex-end;
  }

  .cta-premium__accent {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(242, 241, 237, 0.2);
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  @media screen and (max-width: 749px) {
    .cta-premium {
      border-radius: 16px;
      margin: 0 12px 54px;
      padding: 34px 20px;
    }

    .cta-premium__buttons {
      flex-direction: column;
    }

    .cta-premium__buttons .tlm-btn {
      width: 100%;
    }

    .cta-premium__content,
    .cta-premium__content.left,
    .cta-premium__content.right {
      text-align: center;
      margin-inline: auto;
    }
  }
{% endstylesheet %}

<section class="cta-premium">
  {% if section.settings.background_image != blank %}
    <div class="cta-premium__background">
      {{ section.settings.background_image | image_url: width: 2200 | image_tag: loading: 'lazy' }}
    </div>
  {% endif %}

  <div class="cta-premium__content {{ section.settings.layout }}">
    {% if section.settings.tag != blank %}
      <div class="cta-premium__accent" data-reveal>
        {{ section.settings.tag }}
      </div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="cta-premium__title" data-reveal>{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="cta-premium__description" data-reveal>{{ section.settings.description }}</p>
    {% endif %}
    <div class="cta-premium__buttons" data-reveal>
      {% if section.settings.primary_cta_text != blank and section.settings.primary_cta_url != blank %}
        <a class="tlm-btn" href="{{ section.settings.primary_cta_url }}" data-magnetic>{{ section.settings.primary_cta_text }}</a>
      {% endif %}
      {% if section.settings.secondary_cta_text != blank and section.settings.secondary_cta_url != blank %}
        <a class="tlm-btn tlm-btn--ghost" href="{{ section.settings.secondary_cta_url }}" data-magnetic>{{ section.settings.secondary_cta_text }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA premium",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "Limited release" },
    { "type": "text", "id": "title", "label": "Title", "default": "Own the next statement piece" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Upgrade your wardrobe with premium essentials built for modern movement." },
    { "type": "text", "id": "primary_cta_text", "label": "Primary button label", "default": "Shop collection" },
    { "type": "url", "id": "primary_cta_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_cta_text", "label": "Secondary button label", "default": "Read editorial" },
    { "type": "url", "id": "secondary_cta_url", "label": "Secondary button link" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    {
      "type": "select",
      "id": "layout",
      "label": "Content alignment",
      "default": "centered",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "centered", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "CTA premium"
    }
  ]
}
{% endschema %}
